# ================================
# FinanceOS - Variáveis de ambiente (modelo)
# ================================
# Copie este arquivo para .env.local e preencha com os SEUS valores.
# Nunca faça commit de .env.local (já está no .gitignore).

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publicavel-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui   # SERVER ONLY, nunca expor no front

# --- Banco de dados (Supabase PostgreSQL) ---
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USUARIO:SENHA@HOST:5432/postgres

# --- OpenAI ---
OPENAI_API_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_YEARLY=

# --- Resend ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Upstash Redis ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Sentry ---
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=
